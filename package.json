{
  "name": "shiai-ban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "oxlint --fix . && oxfmt --write . && tsc --noEmit",
    "test": "vp test --run --config vitest.config.ts",
    "test:watch": "vp test --config vitest.config.ts",
    "release:check": "pwsh -NoLogo -NoProfile -File ops/validate-product.ps1",
    "deploy": "npm run release:check && npm run check && npm test && npm run build && wrangler deploy",
    "metrics": "pwsh -NoLogo -NoProfile -File ops/product-metrics.ps1",
    "indexnow": "pwsh -NoLogo -NoProfile -File ops/submit-indexnow.ps1 -BaseUrl https://shiai-ban.yhay81.com",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "4.13.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.0",
    "@cloudflare/workers-types": "5.20260804.1",
    "@types/node": "^26.1.2",
    "@voidzero-dev/vite-plus-core": "0.2.8",
    "miniflare": "^4.20260730.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.8",
    "vitest": "4.1.10",
    "wrangler": "4.119.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@11.16.0"
}
